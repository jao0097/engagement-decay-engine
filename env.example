# Chave da YouTube Data API v3 (console.cloud.google.com -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Chave da Groq (console.groq.com/keys) - gratuita, sem cartão de crédito
GROQ_API_KEY=your_groq_api_key_here

# Opcional: segunda chave Groq, usada como fallback quando a primeira bate rate limit
GROQ_API_KEY_2=

